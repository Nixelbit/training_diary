<h1>Обновление пароля</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

<%= form_with url: password_path(params[:token]), method: :put, data: { test_id: "password-edit-form"} do |form| %>
  <%= form.password_field :password, required: true, autocomplete: "new-password",
    placeholder: "Введите новый пароль", maxlength: 72 %><br>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
    placeholder: "Повторите новый пароль", maxlength: 72 %><br>
  <%= form.submit "Сохранить" %>
<% end %>
