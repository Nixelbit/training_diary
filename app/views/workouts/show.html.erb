<h1 data-test-id="workout-name"><%= @workout.name %></h1>

<p data-test-id="workout-date"><%= @workout.date %></p>

<%= link_to "Редактировать тренировку", edit_workout_path(@workout) %>
<%= button_to "Удалить тренировку", workout_path(@workout), method: :delete,
  form: { data: { turbo_confirm: "Вы уверены, что хотите удалить тренировку?" } } %>

<h3>Упражнения</h3>

<ul>
  <% @workout_exercises.each do |workout_exercise| %>
    <% if @editing_workout_exercise == workout_exercise %>
      <li style="list-style: none; margin-bottom: 15px;">
        <%= form_with model: @editing_workout_exercise,
          data: { test_id: "workout-exercise-update-form" } do |form| %>

          <% if @editing_workout_exercise.errors.any? %>
            <ul class="errors" style="color: red;" data-test-id="workout-exercise-update-form-errors">
              <% @editing_workout_exercise.errors.each do |error| %>
                <li data-test-id="workout-exercise-update-<%= error.attribute %>-error">
                  <%= error.full_message %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <div>
            <%= form.label :exercise_id, "Упражнения" %>
            <%= form.collection_select :exercise_id, @exercises, :id, :name, prompt: "Выберите упражнение" %>
          </div>

          <div>
            <%= form.label :position, "Позиция" %>
            <%= form.number_field :position %>
          </div>

          <%= form.submit "Сохранить" %>
          <%= link_to "Отмена", workout_path(@workout) %>
        <% end %>
      </li>
    <% else %>
      <li>
        <h4>
          <%= workout_exercise.position %> - <%= workout_exercise.exercise.name %>
        </h4>
        <%= link_to "Редактировать", workout_path(@workout, edit_exercise_id: workout_exercise.id) %>
        <%= button_to "Удалить упражнение", workout_exercise_path(workout_exercise), method: :delete,
          form: { data: { turbo_confirm: "Вы уверены, что хотите удалить упражнение?" } } %>

        <ul>
          <% workout_exercise.exercise_sets.each do |exercise_set| %>
            <li>
              <strong>Подход: №<%= exercise_set.position %>:</strong>
              <%= exercise_set.weight %> кг х <%= exercise_set.repetitions %> повторений
              <% if exercise_set.notes.present? %>
                <small>(Примечание: <%= exercise_set.notes %>)</small>
              <% end %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  <% end %>
</ul>

<h3>Добавить упражнение</h3>

<%= form_with model: [@workout, @workout_exercise], data: {
  test_id: "workout-exercise-#{@workout_exercise.persisted? ? 'update' : 'create'}-form"
} do |form| %>
  <% if @workout_exercise.errors.any? %>
    <ul class="errors" data-test-id="workout-exercise-form-errors">
      <% @workout_exercise.errors.each do |error| %>
        <li data-test-id="workout-exercise-<%= error.attribute %>-error"><%= error.full_message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :exercise_id, "Упражнения" %>
    <%= form.collection_select :exercise_id, @exercises, :id, :name, prompt: "Выберите упражнение" %>
  </div>

  <div>
    <%= form.label :position, "Позиция" %>
    <%= form.number_field :position %>
  </div>

  <%= form.submit "Добавить" %>
<% end %>
