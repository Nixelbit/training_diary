<h1>Редактирование тренировки</h1>

<%= form_with model: @workout do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :date %>
    <%= f.date_field :date %>
  </div>

  <%= f.submit "Сохранить изменения" %>
<% end %>

<%= link_to "Назад к тренировке", workout_path(@workout) %>
