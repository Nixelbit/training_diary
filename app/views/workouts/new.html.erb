<h1>Новая тренировка</h1>

<%= form_with model: @workout do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :date %>
    <%= f.date_field :date %>
  </div>

  <%= f.submit "Сохранить тренировку" %>
<% end %>

<%= link_to "Назад ко списку тренировок", workouts_path %>
