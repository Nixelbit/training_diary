<h1>Мои тренировки</h1>

<%= link_to "Создать новую тренировку", new_workout_path %>

<% if @workouts.any? %>
  <ul>
    <% @workouts.each do |workout| %>
      <li>
        <%= link_to workout.name, workout_path(workout), data: { test_id: "workout-name" } %> - <%= workout.date %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>У вас пока нет тренировок. Создайте первую!</p>
<% end %>
